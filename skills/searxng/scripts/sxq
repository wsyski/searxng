#!/usr/bin/env python3
"""Query the host's SearXNG instance and print a compact result list.

Adapted from timeplus-io/AgentSkills `searxng-web-search/scripts/searxng_search.py`
(MIT). Deliberate differences, each forced by how this host actually runs:

  * The env var is SEARXNG_URL, not that project's SEARXNG_BASE_URL. Nothing on
    this host sets the latter, so an unmodified copy silently falls through to its
    own `localhost:8080` default and dies with curl exit 7 / URLError.
  * The default endpoint is the LAN address the container is published on. This
    instance binds 192.168.1.100, NOT loopback - `localhost:8888` is unreachable
    from the host even though 8888 is the published port.
  * Empty results are reported together with `.unresponsive_engines`. A bare
    "no results" reads as "nothing exists"; here it usually means the engines
    were blocked or rate-limited, which is a different conclusion and a
    different next action.

  * `.answers` are printed, not only `.results`. Answerer-style engines - the
    `online_currency`, `online_dictionary` and weather processors - put their
    whole output in `.answers`, and an earlier version of this script read
    `.results` alone. It therefore reported `weather`, `currency`, `define` and
    `translate` as returning nothing, and that reading went into the repository
    as four dead categories. They are not dead; the tool was blind. Measured
    2026-10-30: `-c currency "100 EUR to PLN"` answers, `-c define serendipity`
    answers, `-c weather warszawa` answers, `-c translate "en-pl dog"` answers
    (the `from-to term` form is required - a bare word yields nothing).

Three further diagnostics were added because the failures they name are
INVISIBLE in the output rather than absent from it:

  * `report_foreign_engines` - SearXNG ignores an engine name it cannot load and
    runs the default search instead, so a pinned query can return rows from
    engines nobody asked for, and nothing in the response mentions it.
  * `report_empty_time_range` - SearXNG drops every engine that does not declare
    `time_range_support` when a range is set, so a query can run ZERO engines and
    answer with an empty result and an empty `.unresponsive_engines`.
  * `report_ignored_categories` - a category name the instance does not have
  * `report_engine_data` - an engine can report something about its own response
    through the `engine_data` channel. `sii`, `aktienyheterna` and `placera`
    publish how many rows their relevance filter dropped, which is the
    difference between "nothing matched" and "every row was missing a query
    term". The reporting is generic over engine names, so a new engine that
    publishes the same two keys is covered without an edit here.

`report_ignored_pins` prefers the instance's own `unknown_engines` field, which
this fork added to the JSON response, and falls back to comparing each row's
`engines` against the pin on an instance that does not have it.

All three write to stderr and none changes the results, so `--json` output stays
parseable - which is why they run before the --json return rather than after it.
Each names a cause only when the response supports one: a pinned engine that
matched nothing is reported as having matched nothing, not as not being loaded.

Stdlib only. No third-party imports. `tests/test_sxq.py` (stdlib `unittest`,
run by `make skill.test`) covers both the diagnostics and their wiring into
`main()`, which is the part a direct call to the functions cannot check.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "http://192.168.1.100:8888"


def endpoint(explicit: str | None) -> tuple[str, str]:
    """Return (url, origin) where origin names where the url came from.

    The origin matters: telling someone "falling back to X" when they passed
    the URL explicitly sends them to fix the wrong thing.
    """
    if explicit:
        return explicit.rstrip("/"), "--url"
    # SEARXNG_ENDPOINT first, and the order is not cosmetic: SEARXNG_URL is a
    # REGISTERED Hermes tool variable (hermes_cli/config_defaults.py), so
    # local_env_policy's provider blocklist strips it from every child
    # environment Hermes builds - a terminal spawn, execute_code, a no_agent
    # cron job. Inside an agent this script therefore never saw that variable
    # and silently took the built-in default below, which is right on the host
    # it was written for and wrong everywhere else. SEARXNG_ENDPOINT is
    # unregistered (so it survives) and is already what Firecrawl's own .env
    # calls this same instance.
    for name in ("SEARXNG_ENDPOINT", "SEARXNG_URL"):
        env = (os.environ.get(name) or "").strip()
        if env:
            return env.rstrip("/"), name
    return DEFAULT_URL, "the built-in default"


def build_url(sx: str, args: argparse.Namespace) -> str:
    params = {"q": args.query, "format": "json"}
    if args.categories:
        params["categories"] = args.categories
    if args.engines:
        params["engines"] = args.engines
    if args.language:
        params["language"] = args.language
    if args.time_range:
        params["time_range"] = args.time_range
    if args.safesearch is not None:
        params["safesearch"] = args.safesearch
    if args.page > 1:
        params["pageno"] = args.page
    return f"{sx}/search?" + urllib.parse.urlencode(params)


def fetch(url: str, timeout: int, origin: str) -> dict:
    req = urllib.request.Request(url, headers={"User-Agent": "sxq/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        die(f"HTTP {exc.code} from SearXNG - check the URL and that the instance is up")
    except urllib.error.URLError as exc:
        hint = ""
        if "localhost" in url or "127.0.0.1" in url:
            hint = (
                "\n  note: this instance is published on the LAN address, not "
                "loopback - localhost will not reach it"
            )
        die(f"cannot reach {url}\n  reason: {exc.reason}\n  url came from {origin}{hint}")
    except json.JSONDecodeError:
        die("response was not JSON - is `format=json` enabled in settings.yml?")
    return {}


def die(msg: str) -> None:
    print(f"sxq: {msg}", file=sys.stderr)
    raise SystemExit(1)


def clip(text: str, width: int) -> str:
    text = " ".join((text or "").split())
    return text if len(text) <= width else text[: width - 1].rstrip() + "…"


def report_unresponsive(payload: dict) -> None:
    """The part that changes the caller's conclusion - never silently drop it."""
    bad = payload.get("unresponsive_engines") or []
    if bad:
        print(f"\n!! {len(bad)} engine(s) did not answer:", file=sys.stderr)
        for name, reason in bad:
            print(f"     {name}: {reason}", file=sys.stderr)
        print(
            "   Empty results with this notice mean blocked or rate-limited, "
            "not 'nothing exists'.",
            file=sys.stderr,
        )


def report_ignored_pins(payload: dict, pinned: str) -> bool:
    """The authoritative answer, when the instance gives one.

    This fork adds `unknown_engines` to the JSON response, naming the pins the
    instance does not have. That is a statement from the server and needs no
    inference, so it is preferred over `report_foreign_engines` below. Returns
    True when it reported, so the caller can skip the inference.
    """
    named = [n for n in (payload.get("unknown_engines") or []) if n]
    if not named:
        return False
    print(f"\n!! this instance has no engine named: {', '.join(sorted(named))}", file=sys.stderr)
    print(
        "   SearXNG drops an unknown pin and runs the DEFAULT search in its place, "
        "so these rows are not what you asked for - check `sxq --health`.",
        file=sys.stderr,
    )
    return True


def report_ignored_categories(payload: dict) -> None:
    """A category this instance does not have is worse than an unknown pin.

    An unknown `categories=` name selects no engine at all, so SearXNG runs the
    DEFAULT search: `-c finance-polnd` answered 36 rows from mwmbl, duckduckgo
    web and yahoo. The rows look like a healthy answer from the category that
    was asked for. The fork names them in `unknown_categories`.
    """
    named = [n for n in (payload.get("unknown_categories") or []) if n]
    if not named:
        return
    print(f"\n!! this instance has no category named: {', '.join(sorted(named))}", file=sys.stderr)
    print(
        "   SearXNG drops an unknown category and runs the DEFAULT search in its place, "
        "so these rows are from engines you did not ask for - `sxq --health` lists the real ones.",
        file=sys.stderr,
    )


def report_engine_data(payload: dict) -> None:
    """Whatever an engine said about its own response.

    Three engines publish here today, all for the same reason: their site
    matches more loosely than the query asks. `sii` ORs the terms server-side,
    `placera` ranks near-misses into the page, and `aktienyheterna`'s WordPress
    `search` matches a substring of the body (`granges` hits `Grängesberg`), so
    each keeps a row only when every term is really present. A query whose rows
    all use a synonym (`PKN` for `Orlen`) then comes back empty, and without
    the count that is indistinguishable from "the site has nothing".

    Keyed on nothing but the two field names, so a fourth engine that publishes
    `dropped_rows`/`site_rows` is reported without an edit here.
    """
    for engine, kv in sorted((payload.get("engine_data") or {}).items()):
        dropped = kv.get("dropped_rows")
        site_rows = kv.get("site_rows")
        if dropped and dropped != "0":
            print(
                f"\n!! {engine} dropped {dropped} of {site_rows} row(s) for missing a query term.",
                file=sys.stderr,
            )
            print(
                "   An empty or short answer here is a filter result, not an empty site; "
                "retry with the synonym the source actually uses.",
                file=sys.stderr,
            )


def report_foreign_engines(payload: dict, pinned: str) -> None:
    """The fallback, for an instance whose response carries no `unknown_engines`.

    SearXNG ignores an unknown or inactive engine name and runs the default
    search instead - measured 2026-10-15: engines='mojeek news' returned 96 rows
    from mwmbl, duckduckgo web and sii. Say so instead of letting it pass."""
    want = {e.strip() for e in pinned.split(",") if e.strip()}
    got = {e for r in payload.get("results", []) for e in (r.get("engines") or [])}
    foreign = sorted(got - want)
    if foreign:
        print(f"\n!! results came from engines you did not pin: {', '.join(foreign)}", file=sys.stderr)
        silent = sorted(want - got)
        if not got & want:
            # No row carries a pinned engine, so none of them ran: that IS
            # evidence they are not loaded, and it is the common case - a name
            # SearXNG does not know falls back to the default categories whole.
            print(
                f"   no result carries any engine you pinned, so "
                f"{', '.join(silent) or 'the pinned engine'} is probably not loaded "
                "(inactive or misspelt) - check `sxq --health`.",
                file=sys.stderr,
            )
        elif silent:
            # The distinction that matters: a pinned engine that matched nothing
            # is NOT the same as one that failed to load, and saying so sends
            # the reader after a fault that is not there. Say what was measured.
            print(
                f"   {', '.join(silent)} matched nothing in these results - that is not the same as "
                "not being loaded; check `sxq --health` only if you expected a hit.",
                file=sys.stderr,
            )


def answer_lines(answer: dict) -> list[str]:
    """One answer, flattened to text.

    `.answers` is not one shape. A legacy answerer sets `answer`; the weather
    processor sets `current.summary`; the dictionary processor sets
    `translations`, a list of its own. Keyed on which field is present rather
    than on the engine, so an answerer this script has never seen still prints.
    """
    if answer.get("answer"):
        return [str(answer["answer"])]
    current = answer.get("current") or {}
    if current.get("summary"):
        return [str(current["summary"])]
    lines = []
    for entry in answer.get("translations") or []:
        text = str(entry.get("text") or "")
        if text:
            lines.append(text)
        for definition in (entry.get("definitions") or [])[:2]:
            # wordnik sets `text` to its own first definition, so printing both
            # shows the same sentence twice and reads like a parsing fault.
            if str(definition) != text:
                lines.append(f"  {definition}")
    return lines


def print_answers(answers: list, snippet_width: int) -> None:
    """Answers are results too.

    Reading `.results` alone is what made `weather`, `currency`, `define` and
    `translate` look dead: every one of them answers, and none of them puts a
    row in `.results`. Printed before the result list because an answer is the
    direct reply to the query and a result is a page that might contain one.
    """
    for answer in answers:
        lines = answer_lines(answer)
        if not lines:
            continue
        engine = answer.get("engine") or "?"
        print(f"= {clip(lines[0], snippet_width)}   [{engine}]")
        for line in lines[1:4]:
            print(f"  {clip(line, snippet_width)}")
        if answer.get("url"):
            print(f"  {answer['url']}")
        print()


def report_empty_time_range(payload: dict, time_range: str) -> None:
    """An engine without time_range_support is dropped when a range is set, so
    an empty, error-free answer can mean no engine ran at all."""
    if (
        time_range
        and not payload.get("results")
        and not payload.get("answers")
        and not payload.get("unresponsive_engines")
    ):
        print(
            f"\n!! empty with time_range={time_range} and no failing engine: probably no selected "
            "engine supports time_range. Retry without --time-range and filter by date.",
            file=sys.stderr,
        )


def main() -> None:
    p = argparse.ArgumentParser(
        prog="sxq",
        description="Search the host's SearXNG instance.",
        epilog="Snippets are not sources: quote or analyse a page with firecrawl scrape or defuddle.",
    )
    p.add_argument("query", nargs="?", help="search terms")
    p.add_argument("--url",
                   help="override the instance (default: $SEARXNG_ENDPOINT, then $SEARXNG_URL)")
    # The finance categories are named here because they are the one thing this
    # instance has that a stock SearXNG does not, and nothing else in --help said
    # so. Their engines run ONLY when the category is asked for.
    p.add_argument("--categories", "-c",
                   help="e.g. general,news,science,it,packages,repos; "
                        "fork-local: finance (both markets), finance-poland, "
                        "finance-sweden")
    p.add_argument("--engines", "-e", help="pin engines, e.g. sii,dna rynkow,ksiazak")
    p.add_argument("--language", help="result language, e.g. en,pl")
    p.add_argument("--time-range", help="day|week|month|year")
    p.add_argument("--safesearch", type=int, choices=(0, 1, 2))
    p.add_argument("--max-results", "-n", type=int, default=10)
    p.add_argument("--page", type=int, default=1)
    p.add_argument("--snippet-width", type=int, default=200)
    p.add_argument("--timeout", type=int, default=20)
    p.add_argument("--json", action="store_true", help="emit raw JSON instead of a list")
    p.add_argument("--health", action="store_true", help="check reachability and exit")
    args = p.parse_args()

    sx, origin = endpoint(args.url)

    if args.health:
        try:
            with urllib.request.urlopen(f"{sx}/config", timeout=args.timeout) as r:
                cfg = json.loads(r.read().decode("utf-8", "replace"))
            print(f"ok   {sx}")
            print(f"     version  {cfg.get('version')}")
            print(f"     engines  {len(cfg.get('engines', []))}")
            print(f"     categories {len(cfg.get('categories', []))}")
        except Exception as exc:  # noqa: BLE001 - health must never traceback
            die(f"unhealthy {sx}: {exc}")
        return

    if not args.query:
        p.error("a query is required (or use --health)")

    payload = fetch(build_url(sx, args), args.timeout, origin)

    # Two ways the answer can be somebody else's, or nobody's. Both look healthy,
    # so neither can be left to the reader of the result list.
    #
    # Before the --json return, deliberately: --json is the path a caller pipes
    # into another tool, which is where a silently wrong answer is least
    # visible. They go to stderr and print nothing, so stdout stays a clean
    # JSON document and `sxq ... --json | jq` keeps working.
    if args.engines and not report_ignored_pins(payload, args.engines):
        report_foreign_engines(payload, args.engines)
    report_ignored_categories(payload)
    report_empty_time_range(payload, args.time_range)
    report_engine_data(payload)

    if args.json:
        json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return

    answers = payload.get("answers") or []
    print_answers(answers, args.snippet_width)

    results = payload.get("results") or []
    for item in results[: args.max_results]:
        print(clip(item.get("title", ""), 120))
        print(f"  {item.get('url', '')}")
        engines = item.get("engines") or []
        if engines:
            print(f"  via: {', '.join(engines[:4])}")
        if item.get("content"):
            print(f"  {clip(item['content'], args.snippet_width)}")
        print()

    if not results:
        # An answer is not "no results". Saying it is was the whole mistake:
        # four categories that answer every time were written down as dead.
        if not answers:
            print("no results")
        report_unresponsive(payload)
    else:
        total = payload.get("number_of_results")
        if isinstance(total, int) and total > args.max_results:
            print(f"showing {min(len(results), args.max_results)} of ~{total}")
        report_unresponsive(payload)

    for suggestion in (payload.get("suggestions") or [])[:3]:
        print(f"  did you mean: {suggestion}?")


if __name__ == "__main__":
    main()
