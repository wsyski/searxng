# Local deployment settings (read by docker-compose.yml + docker-compose.override.yml).
# Secrets go in .env.prod (gitignored), not here.

# Pinned by tag and digest. A release that changes the settings schema can stop
# honouring `formats: [html, json]` (200 responses, no results array). To move:
#   docker pull searxng/searxng:latest
#   docker image inspect searxng/searxng:latest --format '{{index .RepoDigests 0}}'
# then confirm postman/run.sh still passes.
SEARXNG_VERSION=2026.10.9-f4822b3fc@sha256:85492ba800a861e3e8ff6014c430e81369fe6ca766a9990595f616d1ce95b272

# Published on the LAN address so Firecrawl and other LAN clients can reach it.
# SearXNG has no authentication: this is an open search proxy for the LAN.
# 127.0.0.1 keeps it private.
SEARXNG_HOST=192.168.1.100
# The entrypoint maps this to GRANIAN_PORT, which is what binds.
SEARXNG_PORT=8888
# Only used to build absolute result links; keep the port in step.
SEARXNG_BASE_URL=http://localhost:8888/

# Keep core-config/ owned by the host user so settings.yml is editable in place.
FORCE_OWNERSHIP=false
